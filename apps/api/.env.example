# --- Database (Supabase Postgres) -----------------------------------------
# 2 connection string RIÊNG BIỆT — xem README gốc mục "Supabase" để biết
# vì sao và cách lấy đúng giá trị từ Supabase Dashboard.
#
# DATABASE_URL: pooled qua Supavisor (Connection Pooling, port 6543,
# "Transaction" mode) — dùng cho app runtime (uvicorn).
DATABASE_URL=postgresql+psycopg://app_backend:<password>@<project-ref>.pooler.supabase.com:6543/postgres
#
# DIRECT_URL: Session Pooler (port 5432, tương thích IPv4) hoặc direct
# connection nếu máy/CI có IPv6 — dùng CHỈ cho Alembic migrations.
DIRECT_URL=postgresql+psycopg://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ----------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Chỉ cần điền nếu project Supabase của bạn dùng JWT ký kiểu HS256 cũ
# (kiểm tra ở Dashboard -> Authentication -> Settings -> JWT Settings).
# Project mới thường ký bất đối xứng — để trống, code sẽ tự dùng JWKS.
SUPABASE_JWT_SECRET=

# --- CORS --------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
# Regex cho domain Vercel preview deployment, ví dụ:
# CORS_ALLOW_ORIGIN_REGEX=https://stock-web-.*\.vercel\.app
CORS_ALLOW_ORIGIN_REGEX=

# --- Data collection ----------------------------------------------------------
MARKET_DATA_PROVIDER=vnstock
HISTORICAL_SYNC_CRON=0 18 * * 1-5
REALTIME_POLL_INTERVAL_SECONDS=60
REALTIME_QUOTE_RETENTION_DAYS=30

# --- Scheduler -----------------------------------------------------------------
# true CHỈ ở service `worker` (đúng 1 instance) — false ở service `api`
# (có thể scale nhiều instance). Xem README mục "Deploy".
RUN_SCHEDULER=false
