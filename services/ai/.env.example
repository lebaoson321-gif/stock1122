# Cùng DATABASE_URL với apps/api (đọc trực tiếp Postgres, không qua API)
# — xem README gốc mục Supabase. Nên dùng connection trực tiếp/session
# pooler (không cần transaction pooler vì đây không phải service chạy
# liên tục xử lý nhiều request đồng thời).
DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres
